   "source": [
    "# Predict positions\n",
    "preds=[]\n",
    "last_measurement = {}\n",
    "\n",
    "\n",
    "\n",
    "for index, row in test_df.iterrows():\n",
    "    vessel = row['vesselId']\n",
    "    time_numeric = row['time_numeric']\n",
    "    if vessel in last_measurement:\n",
    "        lat, long = last_measurement[vessel]\n",
    "    else:\n",
    "        lat = X[X['vesselId'] == vessel]['latitude'].iloc[-1]      \n",
    "        long = X[X['vesselId'] == vessel]['longitude'].iloc[-1]\n",
    "         \n",
    "\n",
    "    pred = model.predict(pd.DataFrame([[time_numeric, vessel, long, lat]], columns=['time_numeric', 'vesselId', 'longitude', 'latitude']))\n",
    "    print(index, end = '\\r', flush = True)\n",
    "    last_measurement[vessel] = [pred[0, 0], pred[0,1]]\n",
    "    preds.append(pred)"
   ]
